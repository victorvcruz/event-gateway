{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "payment.refunded",
  "title": "payment.refunded",
  "description": "Emitido pelo PaymentService após reembolso bem-sucedido (compensação de stock.failed).",
  "type": "object",
  "required": ["event_id", "event_type", "correlation_id", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "payment.refunded" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["payment_id", "order_id", "amount_cents", "refunded_at"],
      "additionalProperties": false,
      "properties": {
        "payment_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "amount_cents": { "type": "integer", "minimum": 1 },
        "refunded_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
