{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "payment.failed",
  "title": "payment.failed",
  "description": "Emitido pelo PaymentService quando o pagamento é recusado — dispara compensação.",
  "type": "object",
  "required": ["event_id", "event_type", "correlation_id", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "payment.failed" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["payment_id", "order_id", "reason"],
      "additionalProperties": false,
      "properties": {
        "payment_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Motivo da recusa (ex: insufficient_funds, card_declined)."
        }
      }
    }
  }
}
