{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stock.reserved",
  "title": "stock.reserved",
  "description": "Emitido pelo InventoryService quando estoque é reservado com sucesso.",
  "type": "object",
  "required": ["event_id", "event_type", "correlation_id", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "stock.reserved" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["reservation_id", "order_id", "items"],
      "additionalProperties": false,
      "properties": {
        "reservation_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sku", "quantity"],
            "additionalProperties": false,
            "properties": {
              "sku": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
